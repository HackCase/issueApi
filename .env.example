GITHUB_TOKEN=          # com acesso de leitura (coletor) e issues:write (create_issues.py)
GITHUB_ORG=            # org cujos repos o coletor lê
GITHUB_REPO=           # opcional: repo padrão do create_issues.py (owner/repo)
DATABASE_URL=postgresql://postgres:dev@localhost:5440/issues   # no docker-compose é sobrescrita
CORS_ORIGINS=http://localhost:5173

# --- núcleo de IA (src/core) ---
LLM_PROVIDER=anthropic            # anthropic | openai (gemini ainda não implementado)
OPENAI_BASE_URL=https://api.openai.com/v1   # openai-compatível: gemini (https://generativelanguage.googleapis.com/v1beta/openai), groq, ollama
LLM_API_KEY=
LLM_MODEL_FAST=                   # ata, sanitização
LLM_MODEL_STRONG=                 # grill, plano
EMBEDDING_PROVIDER=openai         # só openai tem embeddings; vazio = igual a LLM_PROVIDER
EMBEDDING_API_KEY=                # vazio = usa LLM_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                # precisa bater com o modelo
ATAS_MODE=local                   # local | github
ATAS_REPO=owner/repo-de-atas
ATAS_BRANCH=main
MAX_ACOES=12
MAX_TURNOS_GRILL=5
DEDUP_THRESHOLD=0.85
AUTO_APPROVE=false
DRY_RUN=true
